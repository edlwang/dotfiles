# macOS-specific shell config.
# Sourced by bashrc when SYSTEM_OS=macOS. Put macOS-only code here.

# Initialize Homebrew, including when it isn't already on PATH.
# Prefer the installation selected by the existing environment.
if command -v brew >/dev/null 2>&1; then
    eval "$(brew shellenv bash)"
elif [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv bash)"
elif [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv bash)"
fi

alias ls='ls -G'
